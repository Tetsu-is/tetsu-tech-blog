<button id="likeButton" class="like-button" type="button"> いいね </button>
<script>
  const button = document.getElementById("likeButton") as HTMLButtonElement;

  async function handleClick() {
    // console.log("いいねしました");

    if (!button) {
      throw new Error("いいねボタンが見つかりません");
    }

    button.textContent = "いいね済み";
    button.disabled = true;

    const currentUrl = window.location.href;
    const url = new URL(currentUrl);
    const id = "01JHTDF6QZRZCAQHT8CW78M7GW";
    const workersUrl = url.origin + "/likes/" + id;

    try {
      const response = await fetch(workersUrl);
      console.log("resp: ", response);
      console.log(workersUrl);
    } catch (error) {
      console.error("いいねに失敗しました", error);
    }
  }

  if (button) {
    button.addEventListener("click", handleClick);
  }
</script>
