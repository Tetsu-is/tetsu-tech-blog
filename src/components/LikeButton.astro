---
// this receives only the blogID as a prop
const { blogID } = Astro.props;
---

<button id="likeButton" class="like-button" type="button" value={blogID}>
  いいね</button
>
<script>
  const button = document.getElementById("likeButton") as HTMLButtonElement;

  async function handleClick() {
    if (!button) {
      throw new Error("いいねボタンが見つかりません");
    }

    button.textContent = "いいね済み";
    button.disabled = true;
    const id = button.value;
    const url = `${import.meta.env.PUBLIC_API_URL}/api/likes/${id}`;

    try {
      await fetch(url, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
      });
    } catch (error) {
      console.error("いいねに失敗しました", error);
    }
  }

  if (button) {
    button.addEventListener("click", handleClick);
  }
</script>
<style>
  .like-button {
    background-color: rgb(var(--gray));
    color: white;
    border: none;
    border-radius: 4px;
    padding: 0.5em 1em;
    cursor: pointer;
  }
</style>
