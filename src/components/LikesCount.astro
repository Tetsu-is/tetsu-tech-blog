---
const { blogID } = Astro.props;
---

<div class={blogID} id="likes-count">0 likes</div>
<script>
  const likesCountDOM = document.getElementById("likes-count");
  if (!likesCountDOM) {
    throw new Error("Element with id 'likes-count' not found");
  }
  const idFromClassName = likesCountDOM.className;
  const response = await fetch(
    `https://tetsu-tech-blog.pages.dev/api/likes/${idFromClassName}`
  );
  const data = await response.json();

  const likesCount = data.result.likes_count;

  if (!likesCountDOM) {
    throw new Error("Element with id 'likes-count' not found");
  }
  likesCountDOM.textContent = `${likesCount} likes`;
</script>
<style>
  .likes-count {
    color: rgb(var(--gray));
  }
</style>
