---
const { blogID } = Astro.props;
const response = await fetch(
  "https://tetsu-tech-blog.pages.dev/api/likes/" + blogID
);
const data = await response.json();
if (!data.result) {
  return;
}
const likesCount = data.result.likes_count;
---

<div class="likes-count" id="likes-count" title={blogID}>
  {likesCount} likes
</div>
<script>
  const likesCountDOM = document.getElementById("likes-count");
  if (!likesCountDOM) {
    throw new Error("likesCountDOM is null");
  }
  1;
  const id = likesCountDOM.title;
  console.log(id);
</script>
<style>
  .likes-count {
    color: rgb(var(--gray));
  }
</style>
