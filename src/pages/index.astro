---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={SITE_TITLE}
      description={SITE_DESCRIPTION}
      heroImage="/thumbnail.png"
    />
  </head>
  <body>
    <Header />
    <main>
      <div class="hero-image">
        <img src="/icon.jpeg" alt="icon" width={510} />
      </div>
      <h3>Tetsu-is</h3>
      <a href="https://mixi.social/@tetsuis" target="_blank">
        <img
          class="social-icon"
          src="https://d3nihth01o6cp1.cloudfront.net/assets/social_links/mixi2-brands-f3930ca81766ade083913c87b1e3d7baf4458d17b5f5e6585e3e369d5775ae44.png"
          alt="mixi2"
        />
      </a>
    </main>
    <Footer />
  </body>
</html>
