---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Mixi2Link from "../components/Mixi2Link.astro";
import XLink from "../components/XLink.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={SITE_TITLE}
      description={SITE_DESCRIPTION}
      heroImage="/thumbnail.png"
    />
  </head>
  <body>
    <Header />
    <main>
      <div
        class="hero-image"
        style="display: flex; justify-content: center; border-radius: 1000px; overflow: hidden; width: 200px; height: 200px; overflow: hidden;"
      >
        <img
          src="/icon.jpeg"
          alt="icon"
          width={500}
          height="auto"
          style="object-fit: cover;"
        />
      </div>
      <h3>Tetsu-is</h3>
      <br />
      <div
        style="display: flex; gap: 10px; flex-direction: column; align-items: start;"
      >
        <div style="width: 80%;">
          <h4>関西の大学4年生</h4>
        </div>
        <div style="width: 80%;">
          <h4>コンピュータサイエンス学科</h4>
        </div>
      </div>
    </main>
    <Footer />
  </body>
</html>
