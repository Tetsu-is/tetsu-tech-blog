---
import { type CollectionEntry, getCollection } from "astro:content";
import BlogPost from "../../layouts/BlogPost.astro";

export async function getStaticPaths() {
	const posts = await getCollection("blog");
	return posts.map((post: CollectionEntry<"blog">) => ({
		params: { slug: post.slug },
		props: post,
	}));
}
type Props = CollectionEntry<"blog">;

// OG image generation is optional - only run if canvas is available
try {
	const { generateOgImage } = await import("../../../scripts/oggen");
	const posts = await getCollection("blog");
	for (const post of posts) {
		generateOgImage({
			fileName: post.slug,
			title: post.data.title,
		});
	}
} catch (error) {
	console.warn("OG image generation skipped:", error instanceof Error ? error.message : String(error));
}

const post = Astro.props;
const { Content } = await post.render();
---

<BlogPost {...post.data}>
  <Content />
</BlogPost>
